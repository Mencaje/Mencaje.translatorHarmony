  static toMyMemoryCode(iso: string): string {
    const key = iso.trim();
    if (key.length === 0) {
      return 'en';
    }
    const hit = MyMemoryLanguageCodes.MAP[key];
    if (hit !== undefined && hit.length > 0) {
      return hit;
    }
    if (key.length === 2) {
      return key.toLowerCase();
    }
    return key.toLowerCase();
  }
